APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# 留空：development → debug，其余 → release。不要在生产环境写死 debug。
GIN_MODE=

# 必填：MySQL DSN（不是 URL）。parseTime=True 必须保留，否则时间字段扫描失败。
# 本地账号由 compose.yaml 创建，拥有本库全部权限；禁止使用 root。
DATABASE_URL={{SERVICE}}:dev@tcp(127.0.0.1:3306)/{{SERVICE}}?charset=utf8mb4&parseTime=True&loc=Local

DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=15s

# 只有在反向代理后且代理可信时才设为 true
TRUST_PROXY_HEADERS=false
